<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta de Céfiro. Los acentos se redefinen en tiempo de ejecución (color de acento elegido o
        "seguir las luces del PC"), por eso todo lo que usa acento va con DynamicResource.
    -->

    <!-- Fondo -->
    <Color x:Key="CefiroBackgroundColor">#FF06080F</Color>
    <Color x:Key="CefiroBackground2Color">#FF0A0F1E</Color>
    <SolidColorBrush x:Key="CefiroBackgroundBrush" Color="{StaticResource CefiroBackgroundColor}" />

    <LinearGradientBrush x:Key="CefiroBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0B1122" />
        <GradientStop Offset="0.55" Color="#FF070A14" />
        <GradientStop Offset="1" Color="#FF05060C" />
    </LinearGradientBrush>

    <!-- Acentos (se sobrescriben desde ThemeService) -->
    <Color x:Key="CefiroAccentColor">#FF00E5FF</Color>
    <Color x:Key="CefiroAccent2Color">#FF7C4DFF</Color>
    <Color x:Key="CefiroAccentGlowColor">#FF00E5FF</Color>
    <SolidColorBrush x:Key="CefiroAccentBrush" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="CefiroAccent2Brush" Color="#FF7C4DFF" />
    <SolidColorBrush x:Key="CefiroAccentSoftBrush" Color="#2200E5FF" />
    <LinearGradientBrush x:Key="CefiroAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF00E5FF" />
        <GradientStop Offset="1" Color="#FF7C4DFF" />
    </LinearGradientBrush>

    <!-- Estados -->
    <Color x:Key="CefiroGoodColor">#FF00E676</Color>
    <Color x:Key="CefiroWarnColor">#FFFFB300</Color>
    <Color x:Key="CefiroHotColor">#FFFF2E88</Color>
    <Color x:Key="CefiroDangerColor">#FFFF3D5A</Color>
    <SolidColorBrush x:Key="CefiroGoodBrush" Color="{StaticResource CefiroGoodColor}" />
    <SolidColorBrush x:Key="CefiroWarnBrush" Color="{StaticResource CefiroWarnColor}" />
    <SolidColorBrush x:Key="CefiroHotBrush" Color="{StaticResource CefiroHotColor}" />
    <SolidColorBrush x:Key="CefiroDangerBrush" Color="{StaticResource CefiroDangerColor}" />

    <!-- Texto -->
    <SolidColorBrush x:Key="CefiroTextBrush" Color="#FFF2F6FF" />
    <SolidColorBrush x:Key="CefiroTextSecondaryBrush" Color="#FF9AA6C0" />
    <SolidColorBrush x:Key="CefiroTextTertiaryBrush" Color="#FF5D6880" />

    <!-- Cristal -->
    <LinearGradientBrush x:Key="CefiroGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1AFFFFFF" />
        <GradientStop Offset="1" Color="#08FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CefiroGlassStrongBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#26FFFFFF" />
        <GradientStop Offset="1" Color="#0EFFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CefiroGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#38FFFFFF" />
        <GradientStop Offset="0.5" Color="#12FFFFFF" />
        <GradientStop Offset="1" Color="#1EFFFFFF" />
    </LinearGradientBrush>
    <!-- Panel flotante (editor de curva, diálogos): casi opaco para leerse bien sobre el fondo -->
    <LinearGradientBrush x:Key="CefiroSheetBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F5131B2E" />
        <GradientStop Offset="1" Color="#F50A0F1C" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CefiroBackdropDimBrush" Color="#B8040610" />

    <SolidColorBrush x:Key="CefiroDividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CefiroTrackBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CefiroHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CefiroPressedBrush" Color="#0AFFFFFF" />

    <!-- Tipografía -->
    <FontFamily x:Key="CefiroDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="CefiroTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="CefiroSmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>

</ResourceDictionary>
