<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Logotipo de Céfiro: un anillo (el marco de un ventilador) con un degradado cian → violeta y,
        dentro, tres aspas curvas en espiral, como una ráfaga de viento (céfiro = viento suave del oeste).
        Coordenadas en una caja de 64 × 64.
    -->

    <LinearGradientBrush x:Key="CefiroLogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF00E5FF" />
        <GradientStop Offset="0.55" Color="#FF4D8BFF" />
        <GradientStop Offset="1" Color="#FF9B4DFF" />
    </LinearGradientBrush>

    <!-- Una aspa: nace junto al buje y se curva hacia fuera -->
    <PathGeometry x:Key="CefiroBladeGeometry"
                  Figures="M 29.6,26.6 C 30.4,18.2 36.8,11.6 46.2,11.8 C 43.0,15.2 41.4,19.6 41.2,24.6 C 39.2,26.2 37.6,27.8 36.8,29.8 C 34.8,27.4 32.0,26.4 29.6,26.6 Z" />

    <DrawingImage x:Key="CefiroLogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Caja transparente para fijar 64 × 64 -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <!-- Anillo -->
                <GeometryDrawing Geometry="M32,5 A27,27 0 1 1 31.99,5 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource CefiroLogoGradient}" Thickness="4.2" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Aspas -->
                <GeometryDrawing Brush="{StaticResource CefiroLogoGradient}" Geometry="{StaticResource CefiroBladeGeometry}" />
                <GeometryDrawing Brush="{StaticResource CefiroLogoGradient}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 29.6,26.6 C 30.4,18.2 36.8,11.6 46.2,11.8 C 43.0,15.2 41.4,19.6 41.2,24.6 C 39.2,26.2 37.6,27.8 36.8,29.8 C 34.8,27.4 32.0,26.4 29.6,26.6 Z">
                            <PathGeometry.Transform>
                                <RotateTransform Angle="120" CenterX="32" CenterY="32" />
                            </PathGeometry.Transform>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource CefiroLogoGradient}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 29.6,26.6 C 30.4,18.2 36.8,11.6 46.2,11.8 C 43.0,15.2 41.4,19.6 41.2,24.6 C 39.2,26.2 37.6,27.8 36.8,29.8 C 34.8,27.4 32.0,26.4 29.6,26.6 Z">
                            <PathGeometry.Transform>
                                <RotateTransform Angle="240" CenterX="32" CenterY="32" />
                            </PathGeometry.Transform>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Buje -->
                <GeometryDrawing Brush="#FFF2F6FF" Geometry="M32,28.2 A3.8,3.8 0 1 1 31.99,28.2 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
