<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:i="clr-namespace:Cefiro.App.Infrastructure">

    <!-- ===================== Tarjetas de cristal ===================== -->

    <DropShadowEffect x:Key="CefiroCardShadow" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.35" Color="#000000" />

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CefiroGlassBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CefiroGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource CefiroCardShadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Tarjeta interactiva: al pasar el ratón se ilumina con el color de acento -->
    <Style x:Key="GlassCardHover" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CefiroGlassStrongBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CefiroAccentSoftBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.38" Color="{DynamicResource CefiroAccentGlowColor}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassInset" TargetType="Border">
        <Setter Property="Background" Value="#0CFFFFFF" />
        <Setter Property="BorderBrush" Value="#10FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ===================== Texto ===================== -->

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroDisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroDisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
    </Style>

    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroSmallFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextTertiaryBrush}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroDisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="MediumNumber" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ===================== Botones ===================== -->

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF06080F" />
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="12" Background="{DynamicResource CefiroAccentGradientBrush}" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="{DynamicResource CefiroAccentGlowColor}" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.75" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="28" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.35" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="18" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="12" Background="#0FFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1CFFFFFF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CefiroAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#08FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CefiroTextSecondaryBrush}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="10" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#16FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource CefiroAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selector segmentado (RadioButton con forma de píldora) -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CefiroTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#12FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CefiroAccentGradientBrush}" />
                            <Setter Property="Foreground" Value="#FF06080F" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource CefiroAccentGlowColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderBrush" Value="#16FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!-- Tarjeta-botón (modos rápidos, efectos). i:Ui.IsActive = true la marca como activa. -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="18" Background="{StaticResource CefiroGlassBrush}"
                                BorderBrush="{StaticResource CefiroGlassBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="Ring" CornerRadius="18" BorderBrush="{DynamicResource CefiroAccentGradientBrush}" BorderThickness="1.6"
                                Opacity="0" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.7" Color="{DynamicResource CefiroAccentGlowColor}" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CefiroGlassStrongBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CefiroAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="i:Ui.IsActive" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CefiroGlassStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Texto editable que parece un título hasta que se pasa el ratón o se pulsa -->
    <Style x:Key="InlineEdit" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource CefiroAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource CefiroAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MaxLength" Value="40" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="4,1">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#12FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CefiroAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etiqueta y valor de un ajuste con deslizador -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Fila seleccionable (DataContext con IsSelected) -->
    <Style x:Key="SelectableRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0FFFFFFF" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource CefiroAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CefiroAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Muestra de color redonda (DataContext con Brush y, opcionalmente, IsSelected) -->
    <Style x:Key="SwatchButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource CefiroAccentBrush}" StrokeThickness="2" Opacity="0" />
                        <Ellipse x:Name="Dot" Margin="4" Fill="{Binding Brush}" Stroke="#40FFFFFF" StrokeThickness="1">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.55" Color="{Binding Brush.Color}" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Dot" Property="Margin" Value="5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel flotante -->
    <Style x:Key="SheetCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CefiroSheetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CefiroGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="60" ShadowDepth="16" Direction="270" Opacity="0.6" Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Barra lateral ===================== -->

    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CefiroTextTertiaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Indicator" Width="4" HorizontalAlignment="Left" CornerRadius="2" Margin="0,16"
                                Background="{DynamicResource CefiroAccentGradientBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.9" Color="{DynamicResource CefiroAccentGlowColor}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Pill" Margin="12,4" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#10FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource CefiroTextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter TargetName="Pill" Property="Background" Value="#16FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource CefiroAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Deslizador fino con brillo ===================== -->

    <Style x:Key="SliderThumbGlow" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18">
                        <Ellipse Fill="{DynamicResource CefiroAccentBrush}" Opacity="0.35">
                            <Ellipse.Effect>
                                <BlurEffect Radius="8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="14" Height="14" Fill="#FFF2F6FF" Stroke="{DynamicResource CefiroAccentBrush}" StrokeThickness="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CefiroSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource CefiroTrackBrush}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource CefiroAccentGradientBrush}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbGlow}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Chips de estado ===================== -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#1EFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CefiroSmallFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Tooltip de cristal -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F0101626" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource CefiroTextBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
