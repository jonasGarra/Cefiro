<UserControl x:Class="Cefiro.App.Views.FansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Cefiro.App.Controls"
             xmlns:i="clr-namespace:Cefiro.App.Infrastructure"
             Focusable="True">
    <UserControl.Resources>
        <i:EqualsConverter x:Key="Equals" />
        <i:BoolToVisibilityConverter x:Key="BoolToVis" />
        <i:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <i:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Fila "etiqueta ........ valor" + deslizador -->
        <Style x:Key="SliderRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Punto de estado de la emergencia -->
        <Style x:Key="EmergencyDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{StaticResource CefiroGoodBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EmergencyActive}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource CefiroDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Selector BIOS / Fijo / Curva (DataContext = FanChannelViewModel) -->
        <DataTemplate x:Key="ModeSelector">
            <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="BIOS" ToolTip="Lo controla la placa base (o el driver de la gráfica)"
                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Bios}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Fijo" ToolTip="Siempre a la misma velocidad"
                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Fixed}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Curva" ToolTip="La velocidad sigue a la temperatura"
                                 IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=Curve}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Tarjeta de un ventilador -->
        <DataTemplate x:Key="FanCard">
            <Border Style="{StaticResource GlassCardHover}" Margin="0,0,14,14" Padding="18,16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Curva y ajustes" VerticalAlignment="Top"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <ui:SymbolIcon Symbol="Options24" FontSize="18" />
                        </Button>
                        <Border Width="40" Height="40" CornerRadius="12" Background="#14FFFFFF" Margin="0,0,10,0" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="{Binding RoleGlyph}" FontSize="20" Foreground="{DynamicResource CefiroAccentBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBox Style="{StaticResource InlineEdit}" Text="{Binding Name}" i:TextBoxBehaviors.CommitOnEnter="True"
                                     ToolTip="Haz clic para cambiar el nombre" />
                            <TextBlock Style="{StaticResource Caption}" Margin="5,1,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Header, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RoleText, Mode=OneWay}" ToolTip="{Binding RoleEvidence, Mode=OneWay}" /><Run Text="{Binding GroupName, Mode=OneWay, StringFormat='  ·  {0}', TargetNullValue=''}" Foreground="{DynamicResource CefiroAccentBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,14,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BigNumber}" FontSize="30" Text="{Binding RpmText}" />
                            <TextBlock Style="{StaticResource Caption}" Text="RPM" VerticalAlignment="Bottom" Margin="6,0,0,5" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5">
                            <TextBlock Style="{StaticResource Caption}" Text="salida " />
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Foreground="{DynamicResource CefiroAccentBrush}" Text="{Binding OutputText}" />
                        </StackPanel>
                    </Grid>
                    <c:MeterBar Value="{Binding Output}" Marker="{Binding Floor}" Height="8"
                                StartColor="{DynamicResource CefiroAccentColor}" EndColor="{DynamicResource CefiroAccent2Color}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0" Foreground="{StaticResource CefiroTextTertiaryBrush}" Text="{Binding FloorText}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Foreground="{StaticResource CefiroWarnBrush}" Text="{Binding Note}"
                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />

                    <ContentControl Margin="0,14,0,10" HorizontalAlignment="Left" Content="{Binding}" ContentTemplate="{StaticResource ModeSelector}" Focusable="False" />

                    <Grid MinHeight="66">
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding ModeHint}"
                                   Visibility="{Binding IsBios, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding IsFixed, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding FixedText}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Velocidad fija" />
                            </DockPanel>
                            <Grid Margin="0,4,0,0">
                                <Slider Style="{StaticResource CefiroSlider}" Value="{Binding FixedPercent}" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" TickFrequency="1" />
                                <c:FloorBand Floor="{Binding FixedMinimum}" IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsCurve, Converter={StaticResource BoolToVis}}">
                            <c:CurvePreview Height="44" Curve="{Binding Curve}" Temperature="{Binding SourceTemperature}" Floor="{Binding Floor}"
                                            Color="{DynamicResource CefiroAccentColor}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding SourceText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,12,28,28">

                <!-- Cabecera -->
                <DockPanel Margin="4,0,0,18">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                                         Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}" />
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource CefiroAccentBrush}" Margin="0,0,7,0" />
                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding ActivePresetText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Ventiladores" />
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Elige un modo rápido o ajusta cada ventilador. Los mínimos de la bomba y del radiador se respetan siempre." />
                    </StackPanel>
                </DockPanel>

                <!-- Error -->
                <Border CornerRadius="14" Padding="14,10" Margin="0,0,0,16" Background="#26FF3D5A" BorderBrush="#66FF3D5A" BorderThickness="1"
                        Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="18" Foreground="{StaticResource CefiroDangerBrush}" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ErrorText}" />
                    </DockPanel>
                </Border>

                <!-- Modos rápidos -->
                <UniformGrid Columns="5" Margin="0,0,0,24">
                    <Button Style="{StaticResource TileButton}" Margin="0,0,7,0" Command="{Binding ApplyPresetCommand}" CommandParameter="Silent" i:Ui.IsActive="{Binding IsSilentActive}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="24" Foreground="{DynamicResource CefiroAccentBrush}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Silencioso" Margin="0,10,0,3" />
                            <TextBlock Style="{StaticResource Caption}" Text="Lo justo para la temperatura. Para trabajar o ver series." />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Margin="7,0" Command="{Binding ApplyPresetCommand}" CommandParameter="Balanced" i:Ui.IsActive="{Binding IsBalancedActive}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Scales24" FontSize="24" Foreground="{DynamicResource CefiroAccentBrush}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Equilibrado" Margin="0,10,0,3" />
                            <TextBlock Style="{StaticResource Caption}" Text="El punto medio entre ruido y temperatura." />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Margin="7,0" Command="{Binding ApplyPresetCommand}" CommandParameter="Performance" i:Ui.IsActive="{Binding IsPerformanceActive}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Rocket24" FontSize="24" Foreground="{DynamicResource CefiroAccentBrush}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Rendimiento" Margin="0,10,0,3" />
                            <TextBlock Style="{StaticResource Caption}" Text="Más aire y antes. Para jugar o renderizar." />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Margin="7,0" Command="{Binding ApplyPresetCommand}" CommandParameter="Maximum" i:Ui.IsActive="{Binding IsMaximumActive}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="24" Foreground="{DynamicResource CefiroAccentBrush}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Máximo" Margin="0,10,0,3" />
                            <TextBlock Style="{StaticResource Caption}" Text="Todo al 100 %. Para pruebas o calor extremo." />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Margin="7,0,0,0" Command="{Binding ApplyPresetCommand}" CommandParameter="Bios" i:Ui.IsActive="{Binding IsBiosActive}">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="24" Foreground="{DynamicResource CefiroAccentBrush}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Todo en BIOS" Margin="0,10,0,3" />
                            <TextBlock Style="{StaticResource Caption}" Text="Céfiro deja de controlar: decide la placa base." />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Ventiladores -->
                <DockPanel Margin="4,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Run Text="Mostrar conectores sin ventilador (" /><Run Text="{Binding HiddenCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <ui:ToggleSwitch IsChecked="{Binding ShowEmpty}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tus ventiladores" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,14" Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisInv}}"
                           Text="Todavía no hay salidas de ventilador: el servicio está abriendo el hardware o tu placa no permite controlarlas." />

                <ItemsControl ItemsSource="{Binding VisibleChannels}" ItemTemplate="{StaticResource FanCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Seguridad, calibración y grupos -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Seguridad -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,9,0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource EmergencyDot}" />
                                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding EmergencyText}" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Seguridad" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,16"
                                       Text="Si la CPU o la gráfica llegan a su temperatura crítica, todos los ventiladores se ponen al 100 % hasta que se enfríen." />

                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CpuCriticalText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Emergencia de la CPU" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="60" Maximum="100" Value="{Binding CpuCritical}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding GpuCriticalText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Emergencia de la gráfica" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="60" Maximum="95" Value="{Binding GpuCritical}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding CpuWarningText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Aviso de CPU caliente" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="50" Maximum="100" Value="{Binding CpuWarning}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding GpuWarningText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Aviso de gráfica caliente" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="50" Maximum="95" Value="{Binding GpuWarning}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding RecoveryMarginText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Bajar para salir de la emergencia" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="2" Maximum="20" Value="{Binding RecoveryMargin}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding RecoveryHoldText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tiempo frío antes de salir" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="5" Maximum="120" Value="{Binding RecoveryHold}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding SensorTimeoutText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sensor perdido tras" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="2" Maximum="30" Value="{Binding SensorTimeout}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>

                            <Border Style="{StaticResource GlassInset}" Margin="0,4,0,14" Padding="12,10">
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Siempre activo: la bomba nunca baja del 60 % ni se para, el radiador nunca baja del 30 % y la gráfica respeta su mínimo. Si Céfiro se cierra o falla, la BIOS recupera el control." />
                            </Border>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="Restaurar valores seguros" Command="{Binding ResetSafetyCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Calibración -->
                    <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="9,0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel>
                                <ui:SymbolIcon Symbol="Gauge24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Calibración automática" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,14"
                                       Text="Mide a qué velocidad gira y arranca cada ventilador para ajustar sus mínimos. Tarda unos dos minutos por ventilador y se cancela sola si algo se calienta. La bomba nunca baja del 60 %." />

                            <StackPanel Visibility="{Binding CalibrationRunning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <c:MeterBar Value="{Binding CalibrationProgress}" Height="8"
                                            StartColor="{DynamicResource CefiroAccentColor}" EndColor="{DynamicResource CefiroAccent2Color}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,0,0,10" Text="{Binding CalibrationMessage}"
                                       Visibility="{Binding CalibrationMessage, Converter={StaticResource NullToVis}}" />

                            <StackPanel Visibility="{Binding HasCalibrationRows, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Overline}" Text="VENTILADOR" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Overline}" Text="GIRA DESDE" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Overline}" Text="ARRANCA" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Overline}" Text="MÁX. RPM" HorizontalAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding CalibrationRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3" ToolTip="{Binding Status}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="78" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding StopText}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}" Text="{Binding StartText}" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}" Text="{Binding MaxText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <WrapPanel>
                                <Button Style="{StaticResource AccentButton}" Margin="0,0,10,8" Command="{Binding CalibrateAllCommand}"
                                        Visibility="{Binding CalibrationRunning, Converter={StaticResource BoolToVisInv}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Calibrar todos" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,10,8" Command="{Binding CancelCalibrationCommand}" Content="Cancelar"
                                        Visibility="{Binding CalibrationRunning, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,10,8" Command="{Binding ApplyCalibrationCommand}" Content="Aplicar mínimos calibrados"
                                        IsEnabled="{Binding CanApplyCalibration}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Grupos -->
                    <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="9,0,0,0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel>
                                <ui:SymbolIcon Symbol="Group24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Grupos" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,14"
                                       Text="Los ventiladores de un grupo comparten modo y curva (cada uno conserva sus mínimos). Para añadir uno, abre sus ajustes y elige el grupo." />
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource CefiroTextTertiaryBrush}" Text="Todavía no hay grupos."
                                       Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisInv}}" />
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassInset}" Margin="0,0,0,8" Padding="10,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Borrar el grupo"
                                                        Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                                </Button>
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource InlineEdit}" FontSize="14" Text="{Binding Name}" i:TextBoxBehaviors.CommitOnEnter="True" />
                                                    <TextBlock Style="{StaticResource Caption}" Margin="5,1,0,0" Text="{Binding Members}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== Editor de curva y ajustes ===================== -->
        <Grid x:Name="EditorLayer" Visibility="Collapsed" Opacity="0">
            <Border Background="{StaticResource CefiroBackdropDimBrush}" MouseLeftButtonDown="OnBackdropClick" />
            <Border x:Name="EditorCard" Style="{StaticResource SheetCard}" Margin="40,28" MaxWidth="1220" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" DataContext="{Binding Editing}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="EditorScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Cerrar (Esc)" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                        </Button>
                        <ContentControl DockPanel.Dock="Right" Margin="0,2,16,0" VerticalAlignment="Top" Content="{Binding}"
                                        ContentTemplate="{StaticResource ModeSelector}" Focusable="False" />
                        <Border Width="46" Height="46" CornerRadius="14" Background="#16FFFFFF" Margin="0,0,12,0" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="{Binding RoleGlyph}" FontSize="22" Foreground="{DynamicResource CefiroAccentBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBox Style="{StaticResource InlineEdit}" FontSize="20" Text="{Binding Name}" i:TextBoxBehaviors.CommitOnEnter="True" HorizontalAlignment="Left" MinWidth="200" />
                            <TextBlock Style="{StaticResource Caption}" Margin="5,2,0,0">
                                <Run Text="{Binding Header, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RoleText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding RpmText, Mode=OneWay}" /><Run Text=" RPM  ·  salida " /><Run Text="{Binding OutputText, Mode=OneWay}" Foreground="{DynamicResource CefiroAccentBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- Curva -->
                        <StackPanel>
                            <Border Style="{StaticResource GlassInset}" Padding="8,10,8,6">
                                <c:FanCurveEditor Height="380" Curve="{Binding Curve}" CurrentTemperature="{Binding SourceTemperature}"
                                                  CurrentOutput="{Binding Output}" SafetyFloor="{Binding Floor}" AccentColor="{DynamicResource CefiroAccentColor}" />
                            </Border>
                            <DockPanel Margin="2,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="6,0,0,0" Content="Silenciosa"
                                            Command="{Binding DataContext.UseCurvePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Silent" />
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="6,0,0,0" Content="Equilibrada"
                                            Command="{Binding DataContext.UseCurvePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Balanced" />
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="6,0,0,0" Content="Rendimiento"
                                            Command="{Binding DataContext.UseCurvePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Performance" />
                                    <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="6,0,0,0" Content="Al 100 %"
                                            Command="{Binding DataContext.UseCurvePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Plana" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Text="Arrastra los puntos · doble clic para añadir · clic derecho para quitar" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0" Foreground="{StaticResource CefiroWarnBrush}"
                                       Visibility="{Binding IsCurve, Converter={StaticResource BoolToVisInv}}"
                                       Text="Esta curva solo se usa en modo Curva. Elegir una curva de arriba activa ese modo." />
                        </StackPanel>

                        <!-- Ajustes -->
                        <ScrollViewer Grid.Column="2" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Style="{StaticResource Overline}" Text="TEMPERATURA DE REFERENCIA" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding DataContext.SourceOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SourceKey}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,16" Text="{Binding SourceText}" />

                                <StackPanel Style="{StaticResource SliderRow}" Visibility="{Binding IsFixed, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding FixedText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Velocidad fija" />
                                    </DockPanel>
                                    <Grid>
                                        <Slider Style="{StaticResource CefiroSlider}" Value="{Binding FixedPercent}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                        <c:FloorBand Floor="{Binding FixedMinimum}" IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Style="{StaticResource SliderRow}" ToolTip="Cuánto tiene que bajar la temperatura para que el ventilador baje. Evita que suba y baje sin parar.">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding HysteresisText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Histéresis" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource CefiroSlider}" Minimum="0" Maximum="10" Value="{Binding Hysteresis}" IsSnapToTickEnabled="True" TickFrequency="0.5" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SliderRow}" ToolTip="Lo rápido que puede acelerar (en % por segundo).">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding RampUpText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Suavizado al subir" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource CefiroSlider}" Minimum="1" Maximum="50" Value="{Binding RampUp}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SliderRow}" ToolTip="Lo rápido que puede frenar (en % por segundo). Más bajo = más silencioso al terminar una carga.">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding RampDownText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Suavizado al bajar" />
                                    </DockPanel>
                                    <Slider Style="{StaticResource CefiroSlider}" Minimum="1" Maximum="50" Value="{Binding RampDown}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SliderRow}" ToolTip="Por debajo de esto no se baja nunca (la zona roja es el mínimo de seguridad).">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MinimumText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Velocidad mínima" />
                                    </DockPanel>
                                    <Grid>
                                        <Slider Style="{StaticResource CefiroSlider}" Value="{Binding MinimumPercent}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                        <c:FloorBand Floor="{Binding Floor}" IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SliderRow}" ToolTip="Empujón que recibe un ventilador parado para que arranque.">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding StartText}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Empujón de arranque" />
                                    </DockPanel>
                                    <Grid>
                                        <Slider Style="{StaticResource CefiroSlider}" Value="{Binding StartPercent}" IsSnapToTickEnabled="True" TickFrequency="1" />
                                        <c:FloorBand Floor="{Binding MinimumPercent}" IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>

                                <DockPanel Margin="0,0,0,16" Visibility="{Binding CanStop, Converter={StaticResource BoolToVis}}">
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AllowStop}" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Foreground="{StaticResource CefiroTextBrush}" Text="Permitir que se pare (0 RPM)" />
                                        <TextBlock Style="{StaticResource Caption}" Text="Cuando la curva pida menos del mínimo." />
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Visibility="{Binding CanChangeRole, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                                    <TextBlock Style="{StaticResource Overline}" Text="QUÉ HAY CONECTADO" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding DataContext.RoleOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Role" SelectedValue="{Binding Role}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0" Text="{Binding RoleEvidence}" Foreground="{StaticResource CefiroTextTertiaryBrush}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Overline}" Text="GRUPO" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding DataContext.GroupOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding GroupId}" Margin="0,0,0,18" />

                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                        Visibility="{Binding HasRpmSensor, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.CalibrateChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Gauge24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Calibrar este ventilador" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
