<UserControl x:Class="Cefiro.App.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i="clr-namespace:Cefiro.App.Infrastructure"
             Focusable="True">
    <UserControl.Resources>
        <i:BoolToVisibilityConverter x:Key="BoolToVis" />
        <i:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <i:NullToVisibilityConverter x:Key="NullToVis" />
        <i:NullToVisibilityConverter x:Key="EmptyToVis" Invert="True" />

        <!-- Tarjeta de perfil: el activo brilla con el acento -->
        <Style x:Key="ProfileCard" TargetType="Border" BasedOn="{StaticResource GlassCardHover}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CefiroAccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource CefiroGlassStrongBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,12,28,28">

            <!-- Cabecera -->
            <DockPanel Margin="4,0,0,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Command="{Binding ImportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Importar…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding NewProfileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Nuevo perfil con lo actual" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Perfiles" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Guarda juntos tus ventiladores y tus luces, y cámbialos con un clic, con un atajo de teclado, desde la bandeja o al abrir un programa." />
                </StackPanel>
            </DockPanel>

            <!-- Mensajes -->
            <Border CornerRadius="14" Padding="14,10" Margin="0,0,0,14" Background="#26FF3D5A" BorderBrush="#66FF3D5A" BorderThickness="1"
                    Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="18" Foreground="{StaticResource CefiroDangerBrush}" Margin="0,0,10,0" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding ErrorText}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource GlassInset}" Margin="0,0,0,14" Padding="14,10" Visibility="{Binding InfoText, Converter={StaticResource NullToVis}}">
                <DockPanel>
                    <ui:SymbolIcon Symbol="Info24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,10,0" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding InfoText}" />
                </DockPanel>
            </Border>

            <!-- Cambio automático -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20,14">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoSwitch}" />
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="22" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Cambio automático al abrir un programa" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Cuando abras un programa asociado a un perfil, Céfiro lo activa; al cerrarlo, vuelve lo que tenías. Si mientras tanto eliges otro perfil a mano, se respeta tu elección." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Sin perfiles -->
            <Border Style="{StaticResource GlassCard}" Padding="32,28" Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisInv}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Layer24" FontSize="44" Foreground="{DynamicResource CefiroAccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,12,0,6" HorizontalAlignment="Center" Text="Todavía no tienes perfiles" />
                    <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="560"
                               Text="Un perfil guarda juntos los ventiladores y las luces. Deja todo como te guste (por ejemplo, Rendimiento y arcoíris para jugar) y pulsa «Nuevo perfil con lo actual»." />
                    <Button Style="{StaticResource AccentButton}" Margin="0,18,0,0" HorizontalAlignment="Center" Command="{Binding NewProfileCommand}" Content="Crear mi primer perfil" />
                </StackPanel>
            </Border>

            <!-- Perfiles -->
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProfileCard}" Margin="0,0,14,14" Padding="18,16">
                            <StackPanel>
                                <!-- Nombre y estado -->
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Top"
                                            Background="{DynamicResource CefiroAccentSoftBrush}" BorderBrush="{DynamicResource CefiroAccentBrush}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource ChipText}" FontSize="11.5" Foreground="{StaticResource CefiroTextBrush}" Text="{Binding StatusText}" />
                                    </Border>
                                    <Border Width="42" Height="42" CornerRadius="13" Margin="0,0,10,0" Background="{DynamicResource CefiroAccentGradientBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Layer24" FontSize="20" Foreground="#FF06080F" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBox Style="{StaticResource InlineEdit}" FontSize="16" Text="{Binding Name}" i:TextBoxBehaviors.CommitOnEnter="True"
                                                 ToolTip="Haz clic para cambiar el nombre" />
                                        <ItemsControl ItemsSource="{Binding Swatches}" Margin="5,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="10" Height="10" Margin="0,0,5,0" Fill="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Resumen -->
                                <StackPanel Margin="0,14,0,0">
                                    <DockPanel Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="WeatherSqualls24" FontSize="15" Foreground="{StaticResource CefiroTextSecondaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding FansSummary}" />
                                    </DockPanel>
                                    <DockPanel>
                                        <ui:SymbolIcon Symbol="LightbulbFilament24" FontSize="15" Foreground="{StaticResource CefiroTextSecondaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LightingSummary}" />
                                    </DockPanel>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource CefiroDividerBrush}" Margin="0,14" />

                                <!-- Atajo -->
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" MinWidth="150"
                                            Command="{Binding DataContext.RecordHotkeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Pulsa y después la combinación de teclas">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="15" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding HotkeyText}" FontFamily="{StaticResource CefiroTextFont}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Overline}" Text="ATAJO DE TECLADO" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Programas -->
                                <TextBlock Style="{StaticResource Overline}" Text="SE ACTIVA AL ABRIR" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Programs}" Visibility="{Binding HasPrograms, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,6,6" Padding="10,2,4,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource ChipText}" Text="{Binding Name}" />
                                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="4,0,0,0" ToolTip="Quitar"
                                                            Command="{Binding DataContext.RemoveProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox IsEditable="True" Text="{Binding NewProgram, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.RunningApps, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DropDownOpened="OnProgramsDropDownOpened" ToolTip="Escribe el nombre (juego.exe) o elige uno de los programas abiertos" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="12,0,40,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource CefiroTextTertiaryBrush}" Text="juego.exe o un programa abierto…"
                                               Visibility="{Binding NewProgram, Converter={StaticResource EmptyToVis}}" />
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Añadir"
                                            Command="{Binding DataContext.AddProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Buscar el .exe…"
                                            Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                                    </Button>
                                </Grid>

                                <!-- Acciones -->
                                <DockPanel Margin="0,16,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" ToolTip="Exportar a un archivo"
                                                Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Save24" FontSize="16" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" ToolTip="Borrar el perfil"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButton}" Padding="16,7" Margin="0,0,8,0" Content="Activar"
                                                Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Padding="12,7" Content="Guardar lo actual"
                                                ToolTip="Sustituye lo guardado en este perfil por los ventiladores y luces de ahora"
                                                Command="{Binding DataContext.UpdateFromCurrentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
