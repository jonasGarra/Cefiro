<ui:FluentWindow x:Class="Cefiro.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:Cefiro.App.Controls"
                 xmlns:i="clr-namespace:Cefiro.App.Infrastructure"
                 Title="Céfiro"
                 Width="1360" Height="860" MinWidth="1120" MinHeight="720"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource CefiroBackgroundBrush}"
                 Foreground="{StaticResource CefiroTextBrush}"
                 FontFamily="{StaticResource CefiroTextFont}">
    <Window.Resources>
        <i:BoolToVisibilityConverter x:Key="BoolVis" />
        <i:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
        <i:NullToVisibilityConverter x:Key="NullVis" />
        <i:EqualsConverter x:Key="Equals" />
    </Window.Resources>

    <Grid>
        <c:AnimatedBackground />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <ui:TitleBar Grid.Row="0" Title="Céfiro" Height="44" ShowHelp="False">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource CefiroLogoImage}" Width="20" Height="20" />
                </ui:TitleBar.Icon>
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Cursor="Hand" ToolTip="Perfil activo (pulsa para ver los perfiles)"
                                Visibility="{Binding ActiveProfileText, Converter={StaticResource NullVis}}">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="perfiles" />
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Layer24" FontSize="13" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding ActiveProfileText}" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}"
                                Background="#22FFB300" BorderBrush="#66FFB300">
                            <TextBlock Style="{StaticResource ChipText}" Text="MODO DEMO · datos simulados" Foreground="{StaticResource CefiroWarnBrush}" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource CefiroWarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource CefiroGoodBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding ConnectionText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Barra lateral -->
                <Border Grid.Column="0" Margin="12,4,0,14" CornerRadius="22" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1">
                    <DockPanel LastChildFill="False" Margin="0,14">
                        <Image DockPanel.Dock="Top" Source="{StaticResource CefiroLogoImage}" Width="40" Height="40" Margin="0,4,0,18">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.7" Color="{DynamicResource CefiroAccentGlowColor}" />
                            </Image.Effect>
                        </Image>

                        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="panel"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=panel}" ToolTip="Panel">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Gauge24" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="Panel" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="ventiladores"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=ventiladores}" ToolTip="Ventiladores">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="WeatherSqualls24" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="Ventiladores" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="iluminacion"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=iluminacion}" ToolTip="Iluminación">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="LightbulbFilament24" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="Iluminación" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="sensores"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=sensores}" ToolTip="Sensores">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Pulse24" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="Sensores" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton DockPanel.Dock="Top" Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="perfiles"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=perfiles}" ToolTip="Perfiles">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Layer24" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="Perfiles" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Abajo: ajustes -->
                        <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="ajustes"
                                     IsChecked="{Binding CurrentKey, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=ajustes}" ToolTip="Ajustes">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Settings24" FontSize="24" HorizontalAlignment="Center" />
                                <TextBlock Text="Ajustes" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Abajo: emergencia -->
                        <Border DockPanel.Dock="Bottom" Width="44" Height="44" CornerRadius="14" Margin="0,8"
                                Background="#33FF3D5A" BorderBrush="{StaticResource CefiroDangerBrush}" BorderThickness="1"
                                Visibility="{Binding EmergencyActive, Converter={StaticResource BoolVis}}" ToolTip="{Binding EmergencyText}">
                            <ui:SymbolIcon Symbol="Fire24" FontSize="22" Foreground="{StaticResource CefiroDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,4,28,0">
                        <!-- Emergencia -->
                        <Border CornerRadius="16" Padding="18,12" Margin="0,8,0,0" BorderThickness="1" BorderBrush="{StaticResource CefiroDangerBrush}"
                                Visibility="{Binding EmergencyActive, Converter={StaticResource BoolVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#55FF3D5A" />
                                    <GradientStop Offset="1" Color="#15FF2E88" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="#FFFF3D5A" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Fire24" FontSize="22" Margin="0,0,12,0" Foreground="White" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White">
                                    <Run Text="MODO DE EMERGENCIA · todos los ventiladores al 100 %" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding EmergencyText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Sin conexión -->
                        <Border Style="{StaticResource GlassInset}" Margin="0,8,0,0" Visibility="{Binding ShowConnectingBanner, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,0,14,0" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="Conectando con el servicio de Céfiro…" />
                                    <TextBlock Style="{StaticResource Caption}" Text="El servicio controla el hardware aunque cierres esta ventana. Si no aparece en unos segundos, comprueba que el servicio «Céfiro» está en marcha." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Programas en conflicto -->
                        <Border CornerRadius="16" Padding="16,10" Margin="0,8,0,0" Background="#1FFFB300" BorderBrush="#55FFB300" BorderThickness="1"
                                Visibility="{Binding HasConflicts, Converter={StaticResource BoolVis}}" ToolTip="{Binding ConflictDetail}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DismissConflictsCommand}" ToolTip="Ocultar">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                                </Button>
                                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Margin="0,0,12,0" Foreground="{StaticResource CefiroWarnBrush}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding ConflictText}" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Pasa el ratón por aquí para ver qué hacer. Mientras sigan abiertos, las luces o los ventiladores pueden cambiar solos." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False">
                        <ContentControl.RenderTransform>
                            <TranslateTransform />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
