<UserControl x:Class="Cefiro.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Cefiro.App.Controls"
             xmlns:i="clr-namespace:Cefiro.App.Infrastructure"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <i:EqualsConverter x:Key="Equals" />

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,12,28,28">

            <!-- Cabecera -->
            <DockPanel Margin="4,0,0,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Panel" />
                    <TextBlock Style="{StaticResource PageSubtitle}">
                        <Run Text="{Binding CpuName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding GpuName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BoardName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Indicadores -->
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <!-- CPU -->
                <Border Style="{StaticResource GlassCardHover}" Margin="0,0,9,0">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Temperature24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Procesador" />
                        </DockPanel>
                        <c:RingGauge Height="168" Margin="0,10,0,6" Maximum="100" Thickness="13"
                                     Value="{Binding CpuTemp}" Text="{Binding CpuTempText}" Unit="{Binding TemperatureUnit}"
                                     SecondaryValue="{Binding CpuLoad}" Caption="temperatura · uso"
                                     EndColor="{Binding CpuColor}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Uso" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding CpuLoadText}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Frecuencia" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding CpuClockText}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="Consumo" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding CpuPowerText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource GlassCardHover}" Margin="9,0">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Gráfica" />
                        </DockPanel>
                        <c:RingGauge Height="168" Margin="0,10,0,6" Maximum="100" Thickness="13"
                                     Value="{Binding GpuTemp}" Text="{Binding GpuTempText}" Unit="{Binding TemperatureUnit}"
                                     SecondaryValue="{Binding GpuLoad}" Caption="temperatura · uso"
                                     EndColor="{Binding GpuColor}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Uso" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding GpuLoadText}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Punto más caliente" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding GpuHotSpotText}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="Consumo" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding GpuPowerText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource GlassCardHover}" Margin="9,0">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Board24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Memoria" />
                        </DockPanel>
                        <c:RingGauge Height="168" Margin="0,10,0,6" Maximum="100" Thickness="13"
                                     Value="{Binding RamLoad}" Text="{Binding RamLoadText}" Unit="%" Caption="en uso"
                                     EndColor="{DynamicResource CefiroAccent2Color}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Usada" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding RamUsedText}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Temperatura" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding RamTempText}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="VRAM de la gráfica" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding GpuVramText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Placa -->
                <Border Style="{StaticResource GlassCardHover}" Margin="9,0,0,0">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Placa base" />
                        </DockPanel>
                        <c:RingGauge Height="168" Margin="0,10,0,6" Maximum="100" Thickness="13"
                                     Value="{Binding BoardTemp}" Text="{Binding BoardTempText}" Unit="{Binding TemperatureUnit}" Caption="VRM"
                                     EndColor="{Binding BoardColor}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="VRM" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding VrmText}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="Chipset" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding ChipsetText}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="Interior de la caja" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding SystemText}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Historial + esquema -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassCard}" Margin="0,0,9,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="60 s" GroupName="range" Command="{Binding SetWindowCommand}" CommandParameter="60s"
                                                 IsChecked="{Binding Window, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Seconds60}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="10 min" GroupName="range" Command="{Binding SetWindowCommand}" CommandParameter="10m"
                                                 IsChecked="{Binding Window, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Minutes10}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="1 h" GroupName="range" Command="{Binding SetWindowCommand}" CommandParameter="1h"
                                                 IsChecked="{Binding Window, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Hour1}" />
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Historial" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="8" Height="8" Fill="#FF00E5FF" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource Caption}" Text="CPU" Margin="0,0,14,0" />
                                    <Ellipse Width="8" Height="8" Fill="#FFFF2E88" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource Caption}" Text="GPU" Margin="0,0,14,0" />
                                    <TextBlock Style="{StaticResource Caption}" Text="línea continua: temperatura · discontinua: uso (%)" Foreground="{StaticResource CefiroTextTertiaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <lvc:CartesianChart Height="300" Series="{Binding HistorySeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            LegendPosition="Hidden" TooltipPosition="Hidden" AnimationsSpeed="00:00:00" Background="Transparent" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="9,0,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Tu PC en directo" />
                            <TextBlock Style="{StaticResource Caption}" Text="Los ventiladores giran según sus RPM reales y los LEDs muestran su color actual." />
                        </StackPanel>
                        <c:CaseSchematic DataContext="{Binding Schematic}" Height="330" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Ventiladores -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Ventiladores" Margin="4,0,0,10" />
            <ItemsControl ItemsSource="{Binding FanSummaries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCardHover}" Margin="0,0,14,14" Padding="18,16">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="8,2">
                                        <TextBlock Style="{StaticResource ChipText}" FontSize="11" Text="{Binding ModeText}" />
                                    </Border>
                                    <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                    <TextBlock Style="{StaticResource MediumNumber}" Text="{Binding RpmText}" />
                                    <TextBlock Style="{StaticResource Caption}" Text=" RPM" VerticalAlignment="Bottom" Margin="4,0,0,3" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding OutputText}" VerticalAlignment="Bottom" Margin="12,0,0,3" Foreground="{DynamicResource CefiroAccentBrush}" />
                                </StackPanel>
                                <c:MeterBar Value="{Binding Output}" Height="6" />
                                <c:Sparkline Values="{Binding History}" Height="40" Margin="0,10,0,0" Color="{DynamicResource CefiroAccentColor}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
