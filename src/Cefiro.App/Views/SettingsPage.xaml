<UserControl x:Class="Cefiro.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:i="clr-namespace:Cefiro.App.Infrastructure">
    <UserControl.Resources>
        <i:BoolToVisibilityConverter x:Key="BoolToVis" />
        <i:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <i:NullToVisibilityConverter x:Key="NullToVis" />
        <i:NotConverter x:Key="Not" />

        <!-- Fila de ajuste: título y explicación a la izquierda, control a la derecha -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Contador con − / + -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,12,28,28">
            <StackPanel Margin="4,0,0,18">
                <TextBlock Style="{StaticResource PageTitle}" Text="Ajustes" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Aspecto, inicio con Windows, avisos, cómo es tu PC y el estado del servicio." />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===================== Columna izquierda ===================== -->
                <StackPanel>
                    <!-- Apariencia -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Apariencia" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="COLOR DE ACENTO" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Accents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" Width="40" Height="40" Margin="0,0,6,6" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,8,0,16">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Otro color (HEX)" Margin="0,0,12,0" />
                                <ui:TextBox Text="{Binding AccentHex}" Width="130" HorizontalAlignment="Left" MaxLength="7" FontFamily="Consolas"
                                            i:TextBoxBehaviors.CommitOnEnter="True" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingRow}" Margin="0">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AccentFollowsLights}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="Que el acento siga a las luces del PC" />
                                    <TextBlock Style="{StaticResource Caption}" Text="La interfaz toma el color de tus LEDs en cada momento." />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Uso -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Window24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Inicio y ventana" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource SettingRow}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="Abrir Céfiro al iniciar Windows" />
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="Sin avisos de UAC: el servicio que controla el hardware ya arranca solo con Windows; esto abre la ventana (o el icono de la bandeja) al iniciar sesión." />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingRow}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartMinimized}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="Al iniciar con Windows, empezar en la bandeja" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Sin abrir la ventana; el efecto Música y los atajos funcionan igual." />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingRow}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CloseToTray}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="Cerrar la ventana la deja en la bandeja" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Para salir del todo, usa «Salir» en el icono de la bandeja." />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingRow}" Margin="0">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentButton}" Content="°C" IsChecked="{Binding UseFahrenheit, Converter={StaticResource Not}}" />
                                        <RadioButton Style="{StaticResource SegmentButton}" Content="°F" IsChecked="{Binding UseFahrenheit}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" Text="Temperaturas en" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Idioma: español." />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Avisos -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Alert24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Avisos" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingRow}">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ToastsEnabled}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" Text="Notificaciones de Windows" />
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="Temperatura alta, ventilador o bomba a 0 RPM, sensor perdido, modo de emergencia y cambios de perfil. Los límites se ajustan en Ventiladores › Seguridad." />
                                </StackPanel>
                            </DockPanel>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="Probar una notificación" Command="{Binding TestNotificationCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Acerca de -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Image Source="{StaticResource CefiroLogoImage}" Width="46" Height="46" Margin="0,0,14,0">
                                    <Image.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="{DynamicResource CefiroAccentGlowColor}" />
                                    </Image.Effect>
                                </Image>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitle}" FontSize="18">
                                        <Run Text="Céfiro " /><Run Text="{Binding AppVersion, Mode=OneWay}" Foreground="{StaticResource CefiroTextSecondaryBrush}" FontWeight="Normal" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Caption}" Text="Ventiladores e iluminación RGB, con seguridad para tu líquida." />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="HECHO CON" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Credits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource Body}" FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Columna derecha ===================== -->
                <StackPanel Grid.Column="2">
                    <!-- Mi PC -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Cómo es tu PC" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" Text="Para dibujar el esquema del panel tal y como está montado." />

                            <DockPanel Style="{StaticResource SettingRow}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentButton}" Content="Techo" IsChecked="{Binding RadiatorOnTop}" />
                                        <RadioButton Style="{StaticResource SegmentButton}" Content="Frontal" IsChecked="{Binding RadiatorOnTop, Converter={StaticResource Not}}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Body}" Text="Radiador de la líquida en el" VerticalAlignment="Center" />
                            </DockPanel>

                            <DockPanel Style="{StaticResource SettingRow}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Command="{Binding ChangeFansCommand}" CommandParameter="front-"><ui:SymbolIcon Symbol="Subtract24" FontSize="14" /></Button>
                                    <TextBlock Style="{StaticResource FieldValue}" MinWidth="28" TextAlignment="Center" Text="{Binding FrontFans}" />
                                    <Button Style="{StaticResource StepButton}" Command="{Binding ChangeFansCommand}" CommandParameter="front+"><ui:SymbolIcon Symbol="Add24" FontSize="14" /></Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="Ventiladores en el frontal" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingRow}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Command="{Binding ChangeFansCommand}" CommandParameter="rear-"><ui:SymbolIcon Symbol="Subtract24" FontSize="14" /></Button>
                                    <TextBlock Style="{StaticResource FieldValue}" MinWidth="28" TextAlignment="Center" Text="{Binding RearFans}" />
                                    <Button Style="{StaticResource StepButton}" Command="{Binding ChangeFansCommand}" CommandParameter="rear+"><ui:SymbolIcon Symbol="Add24" FontSize="14" /></Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="Ventiladores traseros" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource SettingRow}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource StepButton}" Command="{Binding ChangeFansCommand}" CommandParameter="bottom-"><ui:SymbolIcon Symbol="Subtract24" FontSize="14" /></Button>
                                    <TextBlock Style="{StaticResource FieldValue}" MinWidth="28" TextAlignment="Center" Text="{Binding BottomFans}" />
                                    <Button Style="{StaticResource StepButton}" Command="{Binding ChangeFansCommand}" CommandParameter="bottom+"><ui:SymbolIcon Symbol="Add24" FontSize="14" /></Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Body}" Text="Ventiladores abajo" VerticalAlignment="Center" />
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Overline}" Text="LUCES DE LOS VENTILADORES DE CAJA" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding LightZones}" SelectedItem="{Binding CaseLightZone}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Overline}" Text="LUCES DE LA LÍQUIDA" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding LightZones}" SelectedItem="{Binding AioLightZone}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Programas que interfieren -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Volver a comprobar" Command="{Binding RefreshConflictsCommand}">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" />
                                </Button>
                                <ui:SymbolIcon Symbol="ShieldError24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Programas que pueden interferir" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                       Text="iCUE, MSI Center (Mystic Light), Armoury Crate, SignalRGB, L-Connect, la iluminación dinámica de Windows… Si dos programas mandan a la vez, las luces y los ventiladores cambian solos." />
                            <Border Style="{StaticResource GlassInset}" Padding="12,10" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisInv}}">
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="{StaticResource CefiroGoodBrush}" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource Body}" FontSize="13" Text="No se ha encontrado ninguno abierto." VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Conflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassInset}" Padding="12,10" Margin="0,0,0,8">
                                            <DockPanel>
                                                <ui:SymbolIcon Symbol="Warning24" FontSize="18" Foreground="{StaticResource CefiroWarnBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Body}" FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Servicio -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Servicio y hardware" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Conexión" Margin="0,0,0,8" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="13" Text="{Binding ConnectionText}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Servicio" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" Text="{Binding ServiceVersionText}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Consumo" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" Text="{Binding ServiceUsageText}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Placa" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" Text="{Binding HardwareText}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="PawnIO" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" Text="{Binding PawnIoText}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="OpenRGB" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Body}" FontSize="13" Text="{Binding OpenRgbText}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource CefiroWarnBrush}" Margin="0,12,0,0" Text="{Binding WarningsText}"
                                       Visibility="{Binding WarningsText, Converter={StaticResource NullToVis}}" />
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource CefiroDangerBrush}" Margin="0,8,0,0" Text="{Binding LastErrorText}"
                                       Visibility="{Binding LastErrorText, Converter={StaticResource NullToVis}}" />
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Command="{Binding OpenServiceLogsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Registros del servicio" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenUiLogsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Registros de la interfaz" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
