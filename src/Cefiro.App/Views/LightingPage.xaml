<UserControl x:Class="Cefiro.App.Views.LightingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:Cefiro.App.Controls"
             xmlns:i="clr-namespace:Cefiro.App.Infrastructure">
    <UserControl.Resources>
        <i:BoolToVisibilityConverter x:Key="BoolToVis" />
        <i:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <i:NullToVisibilityConverter x:Key="NullToVis" />
        <i:NotConverter x:Key="Not" />

        <Style x:Key="SliderRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Aviso "OpenRGB no responde": solo cuando ya se sabe el estado -->
        <Style x:Key="OfflineBanner" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasState}" Value="True" />
                        <Condition Binding="{Binding Connected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,12,28,28">

            <!-- Cabecera -->
            <DockPanel Margin="4,0,0,18">
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="14,6" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="LightbulbFilament24" FontSize="16" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource ChipText}" Text="Luces" Margin="0,0,12,0" />
                        <ui:ToggleSwitch IsChecked="{Binding Enabled}" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Iluminación" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding StatusText}" />
                </StackPanel>
            </DockPanel>

            <!-- OpenRGB no disponible -->
            <Border Style="{StaticResource OfflineBanner}" Margin="0,0,0,18">
                <Border CornerRadius="16" Padding="18,14" Background="#22FFB300" BorderBrush="#66FFB300" BorderThickness="1">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="22" Foreground="{StaticResource CefiroWarnBrush}" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="OpenRGB no responde" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="Céfiro habla con tus luces a través de OpenRGB. Comprueba que OpenRGB está en marcha con el servidor SDK activo (puerto 6742); Céfiro se conectará solo en cuanto responda." />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{StaticResource CefiroTextTertiaryBrush}" Text="{Binding ErrorText}"
                                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- Dispositivos + General -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassCard}" Margin="0,0,9,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,5" Command="{Binding RescanCommand}"
                                    ToolTip="Si alguna luz no hace caso: OpenRGB vuelve a buscar los dispositivos y Céfiro les reenvía el efecto. Se hace solo al volver de suspensión.">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Volver a detectar" />
                                </StackPanel>
                            </Button>
                            <ui:SymbolIcon Symbol="LightbulbFilament24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Tus dispositivos" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,12" Visibility="{Binding SyncAll, Converter={StaticResource BoolToVis}}"
                                   Text="Todo va sincronizado. Desactiva «Sincronizar todo» para dar a cada dispositivo, zona o LED su propio efecto." />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,12" Visibility="{Binding SyncAll, Converter={StaticResource BoolToVisInv}}"
                                   Text="Pulsa un dispositivo, una zona o un LED concreto para cambiar solo eso." />

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GlassInset}" Margin="0,0,0,10" Padding="8">
                                        <StackPanel>
                                            <!-- Dispositivo -->
                                            <Border Style="{StaticResource SelectableRow}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                                  Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Hacer parpadear este dispositivo para localizarlo"
                                                            Command="{Binding DataContext.IdentifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Eye24" FontSize="16" />
                                                    </Button>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource ChipText}" FontSize="11.5" Text="{Binding EffectText}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="20" Foreground="{DynamicResource CefiroAccentBrush}" Margin="2,0,10,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- Zonas -->
                                            <ItemsControl ItemsSource="{Binding Zones}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource SelectableRow}" Margin="0,2,0,0" Padding="10,5">
                                                            <Border.InputBindings>
                                                                <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                                                              Command="{Binding DataContext.SelectZoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="250" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource CefiroTextBrush}" VerticalAlignment="Center"
                                                                           Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DisplayName}" />
                                                                <c:LedStrip Grid.Column="1" Colors="{Binding Colors}" SelectedIndex="{Binding SelectedLed}" LedSize="13"
                                                                            IsInteractive="{Binding DataContext.SyncAll, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Not}}"
                                                                            LedClicked="OnLedClicked" Margin="8,0" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                            Visibility="{Binding Resizable, Converter={StaticResource BoolToVis}}"
                                                                            ToolTip="LEDs de este cabezal. Con ventiladores en paralelo, cuenta los de UNO solo (8 en los Corsair RS120).">
                                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                                            Command="{Binding DataContext.RemoveLedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                        <ui:SymbolIcon Symbol="Subtract24" FontSize="14" />
                                                                    </Button>
                                                                    <TextBlock Style="{StaticResource FieldValue}" MinWidth="52" TextAlignment="Center" Text="{Binding LedCountText}" />
                                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                                            Command="{Binding DataContext.AddLedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                                                                    </Button>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding LedCountText}"
                                                                           Visibility="{Binding Resizable, Converter={StaticResource BoolToVisInv}}" />
                                                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="4,0,0,0" ToolTip="Hacer parpadear esta zona"
                                                                        Command="{Binding DataContext.IdentifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                    <ui:SymbolIcon Symbol="Eye24" FontSize="14" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <!-- General -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="Options24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="General" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding BrightnessText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Brillo general" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="0" Maximum="100" Value="{Binding Brightness}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding SpeedMultiplierText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Velocidad general" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="0.25" Maximum="3" Value="{Binding SpeedMultiplier}" IsSnapToTickEnabled="True" TickFrequency="0.05" />
                            </StackPanel>
                            <DockPanel Margin="0,4,0,0">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SyncAll}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Foreground="{StaticResource CefiroTextBrush}" Text="Sincronizar todo" />
                                    <TextBlock Style="{StaticResource Caption}" Text="Un solo efecto para la placa, la líquida, los ventiladores y la RAM." />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Modo noche -->
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding NightEnabled}" />
                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="18" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Modo noche" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" Text="{Binding NightStatusText}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Overline}" Text="DESDE" Margin="0,0,0,5" />
                                    <ui:TextBox Text="{Binding NightStart}" PlaceholderText="23:30" MaxLength="5" i:TextBoxBehaviors.CommitOnEnter="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Overline}" Text="HASTA" Margin="0,0,0,5" />
                                    <ui:TextBox Text="{Binding NightEnd}" PlaceholderText="07:30" MaxLength="5" i:TextBoxBehaviors.CommitOnEnter="True" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource CefiroDangerBrush}" Margin="0,0,0,10"
                                       Text="Escribe las horas como 23:30." Visibility="{Binding NightTimesValid, Converter={StaticResource BoolToVisInv}}" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Atenuar" IsChecked="{Binding NightTurnOff, Converter={StaticResource Not}}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Apagar" IsChecked="{Binding NightTurnOff}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Visibility="{Binding NightTurnOff, Converter={StaticResource BoolToVisInv}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding NightDimText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Brillo por la noche" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="1" Maximum="60" Value="{Binding NightDim}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Efectos -->
            <DockPanel Margin="4,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Padding="12,5" Margin="0,0,10,0" Content="Quitar este ajuste"
                            ToolTip="La zona o el LED vuelve a mostrar el efecto de su dispositivo"
                            Command="{Binding RemoveTargetLayerCommand}" Visibility="{Binding IsPartialTarget, Converter={StaticResource BoolToVis}}" />
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ChipText}" Text="Aplicando a: " />
                            <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource CefiroAccentBrush}" Text="{Binding TargetText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Efecto" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Effects}" Margin="0,0,0,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Padding="14,12" i:Ui.IsActive="{Binding IsActive}"
                                Command="{Binding DataContext.SelectEffectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="20" Foreground="{DynamicResource CefiroAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </DockPanel>
                                <Border Height="4" CornerRadius="2" Margin="0,10,0,8" Background="{Binding Preview}" />
                                <TextBlock Style="{StaticResource Caption}" FontSize="12" Text="{Binding Description}" MinHeight="32" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ajustes del efecto -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Color -->
                <Border Style="{StaticResource GlassCard}" Margin="0,0,9,0">
                    <Grid>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30"
                                   Text="Este efecto no usa colores." Visibility="{Binding ShowColors, Converter={StaticResource BoolToVisInv}}" />
                        <Grid Visibility="{Binding ShowColors, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:ColorWheel Width="230" Height="230" VerticalAlignment="Top" SelectedColor="{Binding WheelColor}" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Overline}" Text="COLORES DEL EFECTO" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding ColorSlots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SwatchButton}" Width="40" Height="40" Margin="0,0,4,0" ToolTip="{Binding Hex}"
                                                        Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Añadir un color" Command="{Binding AddColorCommand}"
                                            Visibility="{Binding CanAddColor, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Quitar el color seleccionado" Command="{Binding RemoveColorCommand}"
                                            Visibility="{Binding CanRemoveColor, Converter={StaticResource BoolToVis}}">
                                        <ui:SymbolIcon Symbol="Subtract24" FontSize="16" />
                                    </Button>
                                </StackPanel>

                                <TextBlock Style="{StaticResource Overline}" Text="HEX" Margin="0,14,0,6" />
                                <ui:TextBox Text="{Binding Hex}" MaxLength="7" Width="140" HorizontalAlignment="Left" FontFamily="Consolas"
                                            i:TextBoxBehaviors.CommitOnEnter="True" ToolTip="Escribe un color como #00E5FF y pulsa Intro" />

                                <DockPanel Margin="0,14,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Guardar el color actual en favoritos"
                                            Command="{Binding AddFavoriteCommand}">
                                        <ui:SymbolIcon Symbol="StarAdd24" FontSize="15" />
                                    </Button>
                                    <TextBlock Style="{StaticResource Overline}" Text="FAVORITOS" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Favorites}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SwatchButton}" Width="30" Height="30" Margin="0,0,2,2"
                                                    ToolTip="{Binding Hex, StringFormat='{}{0} · clic derecho para quitarlo'}" MouseRightButtonUp="OnFavoriteRightClick"
                                                    Command="{Binding DataContext.ApplyFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Parámetros -->
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" Text="{Binding EffectHint}" />

                        <StackPanel Style="{StaticResource SliderRow}" Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding EffectSpeedText}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Velocidad" />
                            </DockPanel>
                            <Slider Style="{StaticResource CefiroSlider}" Minimum="0.1" Maximum="5" Value="{Binding EffectSpeed}" IsSnapToTickEnabled="True" TickFrequency="0.1" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource SliderRow}" Visibility="{Binding ShowBrightness, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding EffectBrightnessText}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Brillo del efecto" />
                            </DockPanel>
                            <Slider Style="{StaticResource CefiroSlider}" Minimum="0" Maximum="100" Value="{Binding EffectBrightness}" IsSnapToTickEnabled="True" TickFrequency="1" />
                        </StackPanel>

                        <DockPanel Margin="0,0,0,14" Visibility="{Binding ShowReverse, Converter={StaticResource BoolToVis}}">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Reverse}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Foreground="{StaticResource CefiroTextBrush}" Text="Sentido contrario" />
                        </DockPanel>

                        <!-- Temperatura -->
                        <StackPanel Visibility="{Binding ShowTemperature, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Overline}" Text="SENSOR" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding SensorOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SensorId}" Margin="0,0,0,14" />
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MinTemperatureText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Frío (color inicial) hasta" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="20" Maximum="95" Value="{Binding MinTemperature}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding MaxTemperatureText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Caliente (color final) desde" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="30" Maximum="105" Value="{Binding MaxTemperature}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Música -->
                        <StackPanel Visibility="{Binding ShowMusic, Converter={StaticResource BoolToVis}}">
                            <StackPanel Style="{StaticResource SliderRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Text="{Binding SensitivityText}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sensibilidad" />
                                </DockPanel>
                                <Slider Style="{StaticResource CefiroSlider}" Minimum="0.2" Maximum="4" Value="{Binding Sensitivity}" IsSnapToTickEnabled="True" TickFrequency="0.1" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="NIVEL DE SONIDO" Margin="0,2,0,6" />
                            <c:MeterBar Value="{Binding AudioLevel}" Height="8" StartColor="{DynamicResource CefiroAccentColor}" EndColor="#FFFF2E88" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{Binding AudioText}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{StaticResource CefiroTextTertiaryBrush}"
                                       Text="El sonido lo escucha esta ventana: déjala abierta o en la bandeja para que las luces sigan la música." />
                        </StackPanel>

                        <!-- Modo del dispositivo -->
                        <StackPanel Visibility="{Binding ShowNative, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Overline}" Text="MODO PROPIO" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding NativeModes}" SelectedItem="{Binding NativeMode}" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource CefiroTextTertiaryBrush}"
                                       Text="Si un dispositivo no tiene ese modo, se usa el suyo más parecido. En zonas o LEDs sueltos se ve como color fijo." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
